<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project:///Assets/UI%20Toolkit/Styles/theme.uss" />

    <!-- Victoire -->
    <ui:VisualElement name="victory-screen" class="screen screen--opaque hidden">
        <ui:VisualElement class="panel panel--end">
            <ui:Label text="FELICITATIONS !" class="title title--win" />
            <ui:Label name="victory-reward" text="" class="end-reward" />
            <ui:VisualElement class="spacer" />
            <ui:Button name="btn-victory-replay" text="Rejouer" class="btn" />
            <ui:Button name="btn-victory-play" text="Jouer au jeu" class="btn hidden" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- Defaite -->
    <ui:VisualElement name="gameover-screen" class="screen screen--opaque hidden">
        <ui:VisualElement class="panel panel--end">
            <ui:Label text="GAME OVER" class="title title--lose" />
            <ui:Label name="gameover-reward" text="" class="end-reward" />
            <ui:VisualElement class="spacer" />
            <ui:Button name="btn-gameover-replay" text="Rejouer" class="btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
