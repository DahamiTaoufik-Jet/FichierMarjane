/* ============================================================
   Theme partage de tout l'UI du jeu.
   Source de verite unique : couleurs, font, controles.
   Modifier une regle ici met a jour TOUS les ecrans.
   ============================================================ */

:root {
    --blue:       rgb(38, 89, 166);
    --blue-hover: rgb(52, 112, 200);
    --blue-press: rgb(26, 64, 122);
    --surface:    rgb(64, 64, 69);
    --panel-bg:   rgba(18, 20, 26, 0.94);
    --scrim:      rgba(0, 0, 0, 0.55);
    --text:       rgb(255, 255, 255);
    --text-dim:   rgb(176, 182, 194);

    -unity-font-definition: url("project:///Assets/UI%20Toolkit/Fonts/PasseroOne%20UITK.asset");
    color: var(--text);
    font-size: 20px;
}

/* ---------- Structure ---------- */

.screen {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--scrim);
}

/* Le panneau se dimensionne sur son contenu : plus de ContentSizeFitter. */
.panel {
    background-color: var(--panel-bg);
    border-radius: 10px;
    padding: 24px 28px;
    min-width: 460px;
    align-items: stretch;
}

/* Ancre le panneau vers le haut (20% du bord), comme l'ancien reglage. */
.screen--top {
    justify-content: flex-start;
    padding-top: 20%;
}

/* Voile des ecrans de fin : gris ardoise presque plein. Le decor reste
   devinable en arriere-plan sans distraire du resultat. Nettement plus
   couvrant que le scrim standard des modales en cours de partie. */
.screen--opaque {
    background-color: rgba(46, 50, 60, 0.88);
}

.title {
    font-size: 34px;
    -unity-text-align: middle-center;
    margin-bottom: 18px;
}

.row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.row__label {
    width: 150px;
    flex-shrink: 0;
}

.row__value {
    width: 62px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
    color: var(--text-dim);
}

.spacer {
    height: 14px;
}

/* ---------- Boutons ---------- */

.btn {
    background-color: var(--blue);
    color: var(--text);
    border-width: 0;
    border-radius: 6px;
    padding: 10px 18px;
    margin: 4px 0;
    font-size: 20px;
    transition-duration: 0.12s;
    transition-property: background-color, scale;
}

.btn:hover {
    background-color: var(--blue-hover);
}

.btn:active {
    background-color: var(--blue-press);
    scale: 0.98 0.98;
}

/* Variante sombre : onglets du journal, actions secondaires. */
.btn--surface {
    background-color: var(--surface);
}

.btn--surface:hover {
    background-color: rgb(84, 84, 92);
}

/* ---------- Controles ---------- */

.slider {
    flex-grow: 1;
    margin: 0 10px;
}

.slider .unity-base-slider__tracker {
    background-color: rgb(46, 48, 56);
    border-width: 0;
    border-radius: 3px;
    height: 5px;
}

.slider .unity-base-slider__dragger {
    background-color: var(--blue);
    border-width: 0;
    border-radius: 8px;
    width: 16px;
    height: 16px;
    margin-top: -6px;
}

.num-field {
    width: 74px;
    flex-shrink: 0;
}

/* Le texte saisi doit rester blanc et lisible (bug recurrent en uGUI). */
.num-field > .unity-base-text-field__input {
    background-color: rgb(30, 32, 40);
    border-color: rgb(70, 74, 86);
    border-width: 1px;
    border-radius: 4px;
    color: var(--text);
    padding: 6px 8px;
    -unity-text-align: middle-center;
}

/* ---------- Rappel des touches ---------- */

.keyline {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.keyline__key {
    width: 130px;
    flex-shrink: 0;
    background-color: var(--surface);
    border-radius: 4px;
    padding: 4px 8px;
    -unity-text-align: middle-center;
    margin-right: 14px;
}

/* ---------- Ecrans de fin ---------- */

/* Ecrans de fin : volontairement imposants, c'est le moment fort du jeu. */
.panel--end {
    min-width: 760px;
    max-width: 1100px;
    padding: 56px 72px;
    border-radius: 16px;
    align-items: center;
}

.panel--end .title {
    font-size: 68px;
    margin-bottom: 28px;
}

.title--win {
    color: rgb(255, 214, 102);
}

.title--lose {
    color: rgb(226, 92, 92);
}

.end-reward {
    font-size: 32px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 10px;
}

.panel--end .btn {
    min-width: 340px;
    padding: 16px 26px;
    font-size: 26px;
    -unity-text-align: middle-center;
}

/* ---------- Cartes de revelation (lettre, bonus, recompense) ---------- */

/* Overlay transparent : la carte flotte, le jeu reste visible derriere. */
.reveal-screen {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.reveal-card {
    background-color: rgb(18, 20, 26);
    border-radius: 14px;
    border-width: 2px;
    border-color: rgb(255, 214, 102);
    padding: 26px 34px;
    min-width: 420px;
    max-width: 620px;
    align-items: center;
    /* transform-origin au centre pour que le pop parte du milieu */
    transform-origin: center;
}

/* Element present dans la mise en page mais pas encore visible : sa place est
   RESERVEE, donc la carte naît a sa taille finale et ne grandit pas en cours
   d'animation quand le texte apparait. */
.invisible {
    visibility: hidden;
}

/* --- Declinaison "recompense de coffre" : dore, texte et bordure noirs.
       Nettement plus grande que les autres cartes : c'est le gain fort. --- */
.reveal-card--reward {
    background-color: rgb(232, 178, 46);
    border-color: rgb(0, 0, 0);
    border-width: 4px;
    min-width: 700px;
    max-width: 900px;
    padding: 46px 60px;
    border-radius: 18px;
}

.reveal-card--reward .reveal-header {
    font-size: 44px;
    margin-bottom: 18px;
}

.reveal-card--reward .reveal-title {
    font-size: 40px;
}

.reveal-card--reward .reveal-header,
.reveal-card--reward .reveal-big,
.reveal-card--reward .reveal-title,
.reveal-card--reward .reveal-desc,
.reveal-card--reward .reveal-sub {
    color: rgb(0, 0, 0);
}

/* --- Declinaison "bonus" : fond blanc. Le texte passe en sombre, sinon il
       serait illisible sur du blanc. --- */
.reveal-card--bonus {
    background-color: rgb(255, 255, 255);
    border-color: rgb(38, 40, 48);
}

.reveal-card--bonus .reveal-header,
.reveal-card--bonus .reveal-big,
.reveal-card--bonus .reveal-title,
.reveal-card--bonus .reveal-sub {
    color: rgb(20, 22, 28);
}

.reveal-card--bonus .reveal-desc {
    color: rgb(78, 82, 92);
}

.reveal-header {
    font-size: 24px;
    color: rgb(255, 214, 102);
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.reveal-icon {
    width: 128px;
    height: 128px;
    margin-bottom: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

/* La grande lettre du mot de passe. */
.reveal-big {
    font-size: 108px;
    color: var(--text);
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.reveal-title {
    font-size: 28px;
    color: var(--text);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 6px;
}

.reveal-desc {
    font-size: 19px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 520px;
}

/* "Position N / A MEMORISER !" */
.reveal-sub {
    font-size: 24px;
    color: rgb(255, 214, 102);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 12px;
}

/* ---------- Bandeau d'indice ---------- */

/* Ancre en haut au centre, comme l'ancien panneau uGUI (1100x400 a -40 du haut). */
.clue-panel {
    position: absolute;
    top: 40px;
    left: 50%;
    translate: -50% 0;
    width: 1100px;
    max-width: 92%;
    background-color: rgb(64, 64, 69);
    border-radius: 10px;
    padding: 40px;
    align-items: center;
}

/* Un indice en image garde un fond neutre : le visuel se suffit. */
.clue-panel--image {
    background-color: rgba(0, 0, 0, 0.35);
}

.clue-text {
    font-size: 36px;
    color: var(--text);
    -unity-text-align: upper-center;
    white-space: normal;
    width: 100%;
}

.clue-image {
    width: 100%;
    height: 320px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------- Avertissement coffres ---------- */

.panel--warning {
    max-width: 900px;
    align-items: center;
}

.title--warning {
    font-size: 52px;
    color: rgb(226, 92, 92);
}

.warning-message {
    font-size: 28px;
    color: var(--text);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 8px;
}

.row--buttons {
    justify-content: center;
    margin-bottom: 0;
}

.row--buttons .btn {
    min-width: 220px;
    margin: 0 10px;
    font-size: 30px;
    -unity-text-align: middle-center;
}

/* ---------- Depot de lettre dans un coffre ---------- */

.panel--chestletter {
    align-items: center;
    min-width: 520px;
}

.attempts {
    font-size: 22px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

/* Grille de lettres : passe a la ligne toute seule quand il y en a beaucoup. */
.letter-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 560px;
    margin-bottom: 14px;
}

.letter-btn {
    width: 76px;
    height: 76px;
    margin: 6px;
    font-size: 40px;
    background-color: var(--blue);
    color: var(--text);
    border-width: 0;
    border-radius: 8px;
    -unity-text-align: middle-center;
    transition-duration: 0.12s;
    transition-property: background-color, scale;
}

.letter-btn:hover {
    background-color: var(--blue-hover);
    scale: 1.06 1.06;
}

.letter-btn:active {
    background-color: var(--blue-press);
    scale: 0.96 0.96;
}

.feedback {
    font-size: 24px;
    color: var(--text);
    -unity-text-align: middle-center;
    white-space: normal;
    min-height: 32px;
}

.feedback--ok {
    color: rgb(126, 214, 126);
}

.feedback--bad {
    color: rgb(226, 92, 92);
}

.hint {
    font-size: 18px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
    margin-top: 10px;
}

/* ---------- Inventaire bonus ---------- */

/* Ancre en bas au centre, comme l'ancien panneau (400x400 a +200 du bas). */
.inventory-panel {
    position: absolute;
    bottom: 120px;
    left: 50%;
    translate: -50% 0;
    width: 560px;
    background-color: var(--panel-bg);
    border-radius: 12px;
    padding: 22px 26px;
    align-items: center;
}

.inventory-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.inventory-arrow {
    width: 46px;
    font-size: 46px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.inventory-content {
    flex-grow: 1;
    align-items: center;
}

.inventory-icon {
    width: 100px;
    height: 100px;
    margin-bottom: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.inventory-name {
    font-size: 32px;
    color: var(--text);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 6px;
}

.inventory-desc {
    font-size: 21px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Une lettre du mot de passe s'affiche seule et en tres grand. */
.inventory-name--letter {
    font-size: 150px;
    color: rgb(255, 214, 102);
    margin-bottom: 0;
}

/* ---------- Enigme textuelle ---------- */

/* Pas de voile : le joueur doit continuer de voir la scene qu'il interroge. */
.puzzle-screen {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.panel--puzzle {
    min-width: 620px;
    max-width: 820px;
    background-color: rgb(64, 64, 69);
    align-items: center;
}

.puzzle-question {
    font-size: 32px;
    color: var(--text);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 18px;
}

.puzzle-answer {
    width: 460px;
    margin-bottom: 14px;
}

/* Champ blanc, texte noir : lisible et clairement identifie comme saisie. */
.puzzle-answer > .unity-base-text-field__input {
    background-color: rgb(255, 255, 255);
    border-color: rgb(150, 155, 165);
    border-width: 2px;
    border-radius: 6px;
    color: rgb(16, 18, 22);
    font-size: 28px;
    padding: 10px 12px;
    -unity-text-align: middle-center;
}

.puzzle-feedback {
    font-size: 22px;
    color: var(--text);
    -unity-text-align: middle-center;
    white-space: normal;
    min-height: 30px;
}

.puzzle-feedback--bad {
    color: rgb(255, 158, 158);
}

/* ---------- Journal ---------- */

.journal-panel {
    position: absolute;
    top: 4%;
    bottom: 4%;
    left: 4%;
    right: 4%;
    background-color: rgb(64, 64, 69);
    border-radius: 14px;
    padding: 20px 24px;
}

.journal-header {
    flex-direction: row;
    align-items: baseline;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.journal-title {
    font-size: 38px;
    color: var(--text);
}

.journal-subtitle {
    font-size: 20px;
    color: var(--text-dim);
    margin-left: 16px;
}

/* La carte occupe toute la place restante. */
.journal-map {
    flex-grow: 1;
}

/* Viewport de la carte : tout ce qui deborde est coupe. C'est le monde a
   l'interieur qu'on deplace, pas une barre de defilement qu'on pilote. */
.journal-viewport {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 10px;
}

/* Conteneur du monde : positionne en absolu et transforme (translate + scale)
   directement par le code, comme le ContentViewContainer d'un GraphView.
   Cela permet de panner librement meme quand le contenu tient dans le viewport,
   ce qu'une ScrollView interdit puisqu'elle borne son offset a zero. */
.journal-world {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: top left;
}

.journal-zoom {
    position: absolute;
    right: 14px;
    top: 14px;
    flex-direction: row;
}

.zoom-btn {
    width: 52px;
    height: 44px;
    margin: 0 4px;
    padding: 0;
    font-size: 24px;
    -unity-text-align: middle-center;
}

.journal-close {
    align-self: center;
    min-width: 360px;
    padding: 18px 28px;
    font-size: 28px;
    margin-top: 16px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* "Retour a la carte", sous le detail d'une etape. */
.journal-modal > .btn {
    min-width: 360px;
    padding: 18px 28px;
    font-size: 28px;
    margin-top: 14px;
    -unity-text-align: middle-center;
}

/* ---------- Noeuds d'etape ---------- */

.stage-node {
    position: absolute;
    width: 88px;
    height: 88px;
    border-radius: 10px;
    border-width: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    transition-duration: 0.12s;
    transition-property: scale;
}

.stage-node:hover {
    scale: 1.07 1.07;
}

.stage-node--resolved {
    background-color: rgb(31, 31, 31);
    color: rgb(255, 255, 255);
}

/* Cliquable : bleu, comme les autres actions du jeu. */
.stage-node--current {
    background-color: var(--blue);
    color: rgb(255, 255, 255);
}

/* Verrouillee, donc inerte : blanc neutre. */
.stage-node--locked {
    background-color: rgb(248, 248, 248);
    color: rgb(150, 150, 150);
}

/* Enigme verrouillee par la phase coffres. */
.stage-node--sealed {
    background-color: rgb(191, 31, 31);
    color: rgb(255, 255, 255);
}

/* Mode selection d'un bonus. */
.stage-node--gold {
    background-color: rgb(230, 179, 26);
    color: rgb(31, 31, 31);
}

.stage-node--green {
    background-color: rgb(51, 204, 77);
    color: rgb(31, 31, 31);
}

.stage-node--ineligible {
    background-color: rgba(128, 128, 128, 0.4);
    color: rgb(186, 186, 186);
}

.stage-node__badge {
    position: absolute;
    top: 4px;
    right: 7px;
    font-size: 17px;
}

.connector {
    position: absolute;
    height: 3px;
    transform-origin: left center;
}

/* ---------- Detail d'une etape ---------- */

.journal-modal {
    flex-grow: 1;
    align-items: center;
}

.modal-tabs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 14px;
    flex-shrink: 0;
}

.tab-btn {
    min-width: 300px;
    padding: 16px 24px;
    margin: 0 8px;
    font-size: 26px;
    -unity-text-align: middle-center;
}

.tab-btn--active {
    background-color: var(--blue);
}

/* Pastille "pas encore vu" sur l'onglet Enigme, quand l'etape porte une image.
   Elle ne capte pas le pointeur pour ne pas voler le clic a l'onglet. */
.tab-badge {
    position: absolute;
    top: 8px;
    right: 10px;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background-color: rgb(255, 200, 60);
    border-width: 2px;
    border-color: rgb(60, 45, 10);
    transform-origin: center;
}

.modal-content {
    flex-grow: 1;
    width: 90%;
    max-width: 1100px;
    background-color: var(--surface);
    border-radius: 10px;
    padding: 28px 34px;
    align-items: center;
    justify-content: center;
}

.modal-text {
    font-size: 28px;
    color: var(--text);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 12px;
}

.modal-text--encrypted {
    color: rgb(255, 214, 102);
    -unity-font-style: italic;
}

.modal-image {
    flex-grow: 1;
    width: 100%;
    min-height: 340px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Plein ecran : l'image couvre tout le journal, avec un bouton retour. */
.image-viewer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(24, 26, 32);
    border-radius: 14px;
    padding: 18px;
    align-items: center;
}

.image-viewer__image {
    flex-grow: 1;
    width: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.image-viewer__hint {
    font-size: 20px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}

.modal-empty {
    font-size: 24px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
}

.hidden {
    display: none;
}
